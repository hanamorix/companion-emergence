#!/usr/bin/env python3
"""A fake `claude` CLI for the real-process stop tests (#456). Never talks to a model.

Reads the prompt from stdin, starts one grandchild named like the MCP server (a sleeper whose argv carries
"brain.mcp_server"), records "<own pid> <grandchild pid>" in $FAKE_CLAUDE_DIR/pids-<own pid>, then waits until
$FAKE_CLAUDE_RELEASE exists (or forever when unset) and prints a JSON result frame with $FAKE_CLAUDE_RESULT.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

if sys.argv[1:] == ["--help"]:
    # The provider's one-time flag probe: answer like the real help text and leave at once.
    print("  --output-format <format>  Output format\n  --tools <tools...>  Tools")
    sys.exit(0)
if sys.argv[1:] == ["--tools=", "-p"]:
    print("Error: Input must be provided", file=sys.stderr)
    sys.exit(1)
try:
    sys.stdin.read()
except Exception:  # noqa: BLE001
    pass
d = Path(os.environ.get("FAKE_CLAUDE_DIR", "."))
grand = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(600)", "brain.mcp_server"])
(d / f"pids-{os.getpid()}").write_text(f"{os.getpid()} {grand.pid}")
release = os.environ.get("FAKE_CLAUDE_RELEASE")
while not (release and Path(release).exists()):
    time.sleep(0.05)
grand.kill()
print(json.dumps({"type": "result", "is_error": False, "result": os.environ.get("FAKE_CLAUDE_RESULT", "ok")}))
